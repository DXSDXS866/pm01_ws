<?xml version="1.0"?>
<package format="3">
  <name>yolo_person_3d</name>
  <version>0.1.0</version>
  <description>YOLO person detection and RGB-D 3D localization for ROS 2 Humble.</description>
  <maintainer email="adrian@example.com">adrian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>pm01_camera_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
